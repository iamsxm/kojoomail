{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kojoo Mail",
  "version": "0.3.2",
  "identifier": "co.kojoo.mail",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Kojoo Mail",
    "longDescription": "多邮箱 + AI 的桌面邮件客户端",
    "externalBin": [
      "binaries/kojoomail-mcp"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwM0Y5N0FDMzYwMUY1NzQKUldSMDlRRTJySmMvRUM4cDdiRWc3OXRXM0RWT2JwOXBGUUZhNEgwWnFxTlNqaGN1TWsxeVBpOXYK",
      "endpoints": [
        "https://mail.songxxai.com/kojoomail/update/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
